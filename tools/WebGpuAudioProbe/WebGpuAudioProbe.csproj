<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../MeltySynth/MeltySynth.csproj" />
    <Compile Include="$(AdapterSource)" Link="MotelNativeAudio.instrumented.cs" />
    <EmbeddedResource Include="$(WebGpuRoot)/KilnGod.WebGPU.ArcadeSample/wwwroot/motel-audio/neon-mile.sf2;$(WebGpuRoot)/KilnGod.WebGPU.ArcadeSample/wwwroot/motel-audio/neon-mile.mid;$(WebGpuRoot)/KilnGod.WebGPU.ArcadeSample/wwwroot/motel-audio/motel-fx-*.wav" LogicalName="MotelAudio.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
