<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(AudioAudit)' == 'true'">$(DefineConstants);MELTYSYNTH_AUDIO_AUDIT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../MeltySynth/src/*.cs" Link="LibrarySource/%(Filename)%(Extension)" />
    <Compile Include="../../MeltySynthTest/src/MidiLoopTestAssets.cs" Link="OriginalFixtures.cs" />
    <Compile Include="../../Workspace/BoundedAudioPipe.cs" Link="BoundedAudioPipe.cs" />
  </ItemGroup>
</Project>
