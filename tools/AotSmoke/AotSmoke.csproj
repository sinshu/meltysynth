<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcGenerateMapFile>true</IlcGenerateMapFile>
    <DefineConstants Condition="'$(PrepareFixtures)' == 'true'">$(DefineConstants);PREPARE_FIXTURES</DefineConstants>
    <DefineConstants Condition="'$(FixedEffectsOff)' == 'true'">$(DefineConstants);FIXED_EFFECTS_OFF</DefineConstants>
    <AssetDirectory Condition="'$(AssetDirectory)' == ''">$(MSBuildProjectDirectory)/../../bin/validation/native-aot/assets</AssetDirectory>
    <LocalPackageVersion Condition="'$(LocalPackageVersion)' == ''">2.4.1</LocalPackageVersion>
    <CoreSourceDirectory Condition="'$(CoreSourceDirectory)' == ''">$(MSBuildProjectDirectory)/../../MeltySynth/src</CoreSourceDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'$(SourceIntegration)' != 'true' and '$(UseLocalPackage)' != 'true'">
    <ProjectReference Include="../../MeltySynth/MeltySynth.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalPackage)' == 'true'">
    <PackageReference Include="MeltySynth" Version="$(LocalPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(SourceIntegration)' == 'true'">
    <Compile Include="$(CoreSourceDirectory)/*.cs" Link="MeltySynth/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PrepareFixtures)' == 'true'">
    <Compile Include="../../MeltySynthTest/src/MidiLoopTestAssets.cs" Link="FixtureBuilder.cs" />
    <Compile Include="../../MeltySynthTest/src/SynthesisBaselineScenario.cs" Link="FixtureScenario.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PrepareFixtures)' != 'true'">
    <None Include="$(AssetDirectory)/*" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
